# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pgvector-enabled).
# Read from the environment as DATABASE_URL. Use the *pooled* or direct
# connection string from the Neon console; keep `sslmode=require`.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# --- LLM provider: Anthropic Claude ---
# Key is read from .env only; it must never be hard-coded or committed.
# Used for answer generation AND the batch LLM-as-judge verification call.
ANTHROPIC_API_KEY=sk-ant-...

# --- Models ---
# LLM for generation + judge.
LLM_MODEL=claude-sonnet-5
# Fast model for low-stakes decisions (retrieval sufficiency assess,
# smoke-eval question drafting) — failures fail safe, so speed wins.
ASSESS_MODEL=claude-haiku-4-5-20251001
# Embeddings run LOCALLY via sentence-transformers (no API key needed —
# Anthropic has no embeddings API; design-doc §4 lists this as the alternative).
# NOTE: EMBEDDING_DIM must match both the model AND the vector(N) column in
# schema.sql. multilingual-e5-small -> 384. Change one, change all three.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Pipeline knobs ---
# Number of chunks retrieved per question (pgvector top-k).
TOP_K=6
# Release-gate threshold for the unsupported-claim rate (4% per
# project-requirements.md). The eval script exits non-zero above this.
UNSUPPORTED_RATE_THRESHOLD=0.04
# Where structured jsonl events are appended (see design-doc Section 6).
LOG_PATH=logs/events.jsonl

# --- Public-deployment guardrails (all inactive by default for local dev) ---
# Non-empty ACCESS_CODE makes the UI require this code before use.
ACCESS_CODE=
# Max questions per browser session / per UTC day (cost caps for public demos).
SESSION_QUERY_LIMIT=10
DAILY_QUERY_BUDGET=50
# Max companies in the corpus via on-demand onboarding (0 = unlimited).
MAX_TICKERS=0

# --- LangSmith tracing (optional; off by default) ---
# Set LANGSMITH_TRACING=true and paste your API key to see full request
# traces (LangGraph nodes + every LLM call) at smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsignal
